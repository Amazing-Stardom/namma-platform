<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_train_list.xml — Shows next 3 trains for the selected station.
    Blue toolbar, subtitle, RecyclerView of train cards.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary_blue">

    <!-- Blue toolbar with back button and station name as title -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_blue_dark"
        app:titleTextColor="@color/white_text"
        app:navigationIconTint="@color/white_text" />

    <!-- "Next 3 Trains" subtitle -->
    <TextView
        android:id="@+id/tv_next_trains_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/next_trains_title"
        android:textColor="@color/accent_yellow"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <!-- Train cards list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_trains"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>
