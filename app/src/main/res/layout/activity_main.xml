<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — Station selection screen.
    Full blue background, Kannada title, subtitle, train emoji, spinner, yellow button.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_blue"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- Kannada app name -->
        <TextView
            android:id="@+id/tv_app_name_kannada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name_kannada"
            android:textColor="@color/white_text"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textColor="#B3E5FC"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Train icon emoji -->
        <TextView
            android:id="@+id/tv_train_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/train_icon"
            android:textSize="72sp"
            android:gravity="center"
            android:layout_marginBottom="40dp" />

        <!-- Station selector card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@color/card_background">

                <!-- Select station label -->
                <TextView
                    android:id="@+id/tv_select_station"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_station_label"
                    android:textColor="@color/primary_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Station spinner -->
                <Spinner
                    android:id="@+id/spinner_station"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/spinner_bg"
                    android:padding="12dp"
                    android:textSize="16sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- View Trains button -->
        <Button
            android:id="@+id/btn_view_trains"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/btn_view_trains"
            android:textColor="@color/black_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent_yellow"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>
