<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nammaplatform.app">

    <!--
        Namma Platform — offline railway station guide.
        No internet permission required; all data is local.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NammaPlatform">

        <!-- Main / launcher screen: station selection -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Train list screen -->
        <activity
            android:name=".TrainListActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity" />

        <!-- Coach layout + TTS screen -->
        <activity
            android:name=".CoachLayoutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".TrainListActivity" />

    </application>
</manifest>
